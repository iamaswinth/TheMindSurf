# =============================================================================
# RAG Comparator Backend - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# =============================================================================
# OpenAI Configuration (Required for AI Enhancement)
# =============================================================================

# Your OpenAI API key - Required for AI-enhanced summaries
OPENAI_API_KEY=sk-your-api-key-here

# Vision model to use (must support images)
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo
OPENAI_VISION_MODEL=gpt-4o

# Maximum tokens for AI response generation
OPENAI_MAX_TOKENS=2000

# Temperature for AI responses (0.0-1.0, lower = more deterministic)
OPENAI_TEMPERATURE=0.3

# =============================================================================
# Application Settings
# =============================================================================

# Application name
APP_NAME=RAG Comparator Backend

# Application version
APP_VERSION=1.0.0

# Enable debug mode (verbose logging, auto-reload)
DEBUG=false

# =============================================================================
# Multimodal Processing Configuration
# =============================================================================

# Enable multimodal document processing
ENABLE_MULTIMODAL_PROCESSING=true

# Default PDF processing strategy: "hi_res" (accurate) or "fast"
DEFAULT_PROCESSING_STRATEGY=hi_res

# Enable AI enhancement for chunks with tables/images
ENABLE_AI_ENHANCEMENT=true

# Timeout for AI enhancement API calls (seconds)
AI_ENHANCEMENT_TIMEOUT=60

# =============================================================================
# Pinecone Vector Database Configuration
# =============================================================================

# Pinecone API key - Required for vector search
PINECONE_API_KEY=your-pinecone-api-key-here

# Index names for hybrid search
PINECONE_DENSE_INDEX_NAME=rag-comparator-dense
PINECONE_SPARSE_INDEX_NAME=rag-comparator-sparse

# Cloud provider and region (must match your Pinecone organization)
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Default namespace for document vectors
PINECONE_NAMESPACE=documents

# Embedding models (Pinecone integrated inference)
PINECONE_DENSE_MODEL=llama-text-embed-v2
PINECONE_SPARSE_MODEL=pinecone-sparse-english-v0
PINECONE_RERANK_MODEL=bge-reranker-v2-m3

# Search parameters
PINECONE_TOP_K=5
PINECONE_RERANK_TOP_N=5
PINECONE_UPSERT_BATCH_SIZE=40

# =============================================================================
# Chunking Parameters
# =============================================================================

# Hard maximum characters per chunk
MAX_CHUNK_CHARACTERS=3000

# Soft limit - prefer to start new chunk after this many characters
NEW_CHUNK_AFTER_N_CHARS=2400

# Minimum characters to keep a chunk separate (merge if smaller)
MIN_CHUNK_CHARACTERS=500

# =============================================================================
# File Handling
# =============================================================================

# Maximum file upload size in megabytes
MAX_FILE_SIZE_MB=50

# =============================================================================
# Logging
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log when AI enhancement is used (for cost tracking)
LOG_AI_USAGE=true
